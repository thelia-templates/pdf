<style>
{% verbatim %}
    @page { margin: 10mm 10mm 13mm 10mm; }

    h1, h2, h3, h4 {
        color:#f6993c;
        margin: .5em 0;
    }

    h1 { font-size: 30px; }
    h2 { font-size: 16px; }
    h3 { font-size: 14px; }
    h4 { color:#58585a; font-size: 12px; }

    p, td { color:#58585a; font-size: 9px; }
    p { margin: .5em 0; }
    span { font-size: 9px; }

    table { border-collapse: collapse; width: 100%; }
    tr { width: 100%; }
    td { vertical-align: top; }

    .table-info { margin-bottom : 15px; }
    .table-info h3 { font-size: 12px; color: #58585a; margin-top: 0; margin-bottom: 6px; }
    .table-info h3 span { font-size: inherit; color: #f6993c; }

    .table-1 td { background: #f1f3f4; border:solid 1px #bcbdc0; }
    .table-1 h4 { font-size: 10px; margin: .2em 0; }
    .table-2 td { border:solid 1px #bcbdc0; }
    .table-2 p { margin: 0; }

    .store-imprint p { font-size: 8px; color: #747475; margin: 0; line-height: 1.35; }
    .store-imprint .store-imprint-name { font-size: 9px; color: #58585a; }

    .product-title { font-size: 9px; }
    .product-meta { font-size: 8px; color: #747475; }

    .table-3-1, .table-3-2 { border: solid 1px #bcbdc0; }
    .table-3-1 span { font-size: 8px; color: #747475; }
    .table-3-1 p { font-size: 10px; }
    .table-3-2 { background: #f1f3f4; }

    .table-3-module h3 { margin-top: 1.5em; }
    .table-3-module span { font-size: 11px; }

    .align-left { text-align: left; }
    .align-center { text-align: center; }
    .align-right{ text-align: right; }

    .clear { padding: 0.5%; border-bottom:solid 1px #dddddd; }
    .clear-none { padding: 0.5%; }

    /* dompdf pins a fixed element to the page content box, so a negative offset is needed
       to move the footer into the bottom margin and keep it clear of the page content. */
    .pdf-footer { position: fixed; bottom: -6mm; left: 0; right: 0; }
    /* dompdf 3.1 resolves counter(page) but not counter(pages) (always 0), so only the
       current page number is shown; the total is intentionally omitted. */
    .pdf-footer .page-counter:after { content: counter(page); }
{% endverbatim %}
{{ hook('invoice.css') }}
</style>

{# The language of this document is the one the order was placed in, not the one of
   whoever prints it: the customer is the one who keeps it. `locale` cannot say it — the
   Twig engine replaces whatever the caller passed with the language of the current
   request — so it is taken back from the order this document prints. A language the
   merchant has since deactivated is still the language of an old order, hence
   `active`/`visible` at '*'. #}
{% set document_locale %}
    {%- for order in loop('document-language.order', 'order', {id: order_id, customer: '*'}) -%}
        {%- for language in loop('document-language.lang', 'lang', {id: order.LANG, active: '*', visible: '*'}) -%}
            {{- language.LOCALE -}}
        {%- endfor -%}
    {%- endfor -%}
{% endset %}
{# An order that can no longer be read falls back to the language of the page. #}
{% set document_locale = document_locale|trim ?: locale %}

{# Legal identifiers of the store, built once and printed both in the page footer and in the
   imprint below. Each one shows up only when it has been filled in. #}
{% set legal_identifiers = [] %}
{% if config('store_siret') %}{% set legal_identifiers = legal_identifiers|merge(['SIRET: '|trans({}, 'pdf', document_locale) ~ config('store_siret')]) %}{% endif %}
{% if config('store_ape_code') %}{% set legal_identifiers = legal_identifiers|merge(['APE code: '|trans({}, 'pdf', document_locale) ~ config('store_ape_code')]) %}{% endif %}
{% if config('store_vat_intracom') %}{% set legal_identifiers = legal_identifiers|merge(['VAT: '|trans({}, 'pdf', document_locale) ~ config('store_vat_intracom')]) %}{% endif %}
{% if config('store_eori') %}{% set legal_identifiers = legal_identifiers|merge(['EORI: '|trans({}, 'pdf', document_locale) ~ config('store_eori')]) %}{% endif %}
{% if config('store_vat_exempt') == '1' %}{% set legal_identifiers = legal_identifiers|merge(['VAT not applicable, article 293 B of the French tax code'|trans({}, 'pdf', document_locale)]) %}{% endif %}
{% if config('store_registration_exempt') == '1' %}{% set legal_identifiers = legal_identifiers|merge(['Exempt from registration with the trade and companies register (RCS) and the trade register (RM)'|trans({}, 'pdf', document_locale)]) %}{% endif %}
{% if config('store_legal_mentions') %}{% set legal_identifiers = legal_identifiers|merge([config('store_legal_mentions')]) %}{% endif %}
{# A shop that never filled the dedicated keys keeps printing its legacy free-text identifier. #}
{% if legal_identifiers is empty and config('store_business_id') %}{% set legal_identifiers = [config('store_business_id')] %}{% endif %}

<div class="pdf-footer">
    {{ hook('invoice.footer-top', {order: order_id}) }}
    <table>
    <col style="width:15%">
    <col style="width:70%">
    <col style="width:15%">
        <tbody>
        <tr>
            <td></td>
            <td class="align-center">
                {% set city = config('store_zipcode') ~ ' ' ~ config('store_city') %}
                {{ config('store_name') }}
                {% if city|trim %} - {{ city }}{% endif %}
                {% if legal_identifiers is not empty %} - {{ legal_identifiers|join(' - ') }}{% endif %}
            </td>
            <td class="align-right">{{ 'page'|trans({}, 'pdf', document_locale) }} <span class="page-counter"></span></td>
        </tr>
        </tbody>
    </table>
</div>

<div class="pdf-header">{{ hook('invoice.header', {order: order_id}) }}</div>

{% for order in loop('order.invoice', 'order', {id: order_id, customer: '*'}) %}
{% set currency = order.CURRENCY %}
<table class="table-info" style="margin-bottom: 15px;">
    <tr>
        <td>
            <h1 style="text-transform: capitalize"><strong style="color: #58585a;">{{ 'INVOICE'|trans({}, 'pdf', document_locale) }}</strong> {{ config('store_name') }}</h1>
        </td>
    </tr>
</table>
<table class="table-info">
    <col style="width: 60%; padding: 0mm;" />
    <col style="width: 40%; padding: 0mm;" />
    <tr>
        <td>
            <table>
                <tr>
                    <td><h3>{{ 'Invoice date'|trans({}, 'pdf', document_locale) }} : <span>{{ format_date(order.INVOICE_DATE, 'date') }}</span></h3></td>
                </tr>
                <tr>
                    <td><h3>{{ 'Invoice REF'|trans({}, 'pdf', document_locale) }} : <span>FA{{ order.REF|slice(3) }}</span></h3></td>
                </tr>
                <tr>
                    <td><h3>{{ 'Customer Number'|trans({}, 'pdf', document_locale) }} : <span>{% for customer in loop('customer.invoice', 'customer', {id: order.CUSTOMER, current: 0}) %}{{ customer.REF }}{% endfor %}</span></h3></td>
                </tr>
                {% for fragment in hook_block('invoice.information', {order: order_id, fields: 'title,value'}) %}
                <tr>
                    <td><h3>{{ fragment.title }} : <span>{{ fragment.value }}</span></h3></td>
                </tr>
                {% endfor %}
            </table>
        </td>
        <td class="store-imprint align-right">
            {% set imprint = hook('invoice.imprint', {order: order_id}) %}
            {% if imprint is not empty %}{{ imprint }}{% else %}
                <p class="store-imprint-name"><strong>{{ config('store_name') }}</strong></p>
                {% for line in [config('store_address1'), config('store_address2'), config('store_address3')] %}
                    {% if line|trim %}<p>{{ line }}</p>{% endif %}
                {% endfor %}
                {% set city = config('store_zipcode') ~ ' ' ~ config('store_city') %}
                {% if city|trim %}<p>{{ city }}</p>{% endif %}
                {% if config('store_country') %}
                    {% for country in loop('address.country.title', 'country', {visible: '*', id: config('store_country')}) %}<p>{{ country.TITLE }}</p>{% endfor %}
                {% endif %}
                {% for identifier in legal_identifiers %}<p>{{ identifier }}</p>{% endfor %}
                {% if config('store_phone') %}<p>{{ 'Phone: '|trans({}, 'pdf', document_locale) }}{{ config('store_phone') }}</p>{% endif %}
                {% if config('store_email') %}<p>{{ 'Email: '|trans({}, 'pdf', document_locale) }}{{ config('store_email') }}</p>{% endif %}
            {% endif %}
        </td>
    </tr>
</table>

{{ hook('invoice.after-information', {order: order_id}) }}

<table class="table-address">
    <col style="width: 50%; padding: 3mm;" />
    <col style="padding: 3mm;" />
    <tr>
        <td style="border-left: solid 1mm #f6993c;" >
            <h3>{{ 'Delivery address'|trans({}, 'pdf', document_locale) }}</h3>
            {% set deliveryAddress = hook('invoice.delivery-address', {module: order.DELIVERY_MODULE, order: order_id}) %}
            {% if deliveryAddress is not empty %}{{ deliveryAddress }}{% else %}{{ format_address(order.DELIVERY_ADDRESS, document_locale)|raw }}{% endif %}
        </td>
        <td style="border-left: solid 1mm #f6993c;">
            <h3>{{ 'Invoice address'|trans({}, 'pdf', document_locale) }}</h3>
            {{ format_address(order.INVOICE_ADDRESS, document_locale)|raw }}
            {# format_address() builds a postal address through commerceguys/addressing, which has
               no slot for a tax identifier: the company name comes out as the organization line,
               the identifiers have to be written here. Electronic invoicing requires both of them
               for a business buyer. #}
            {% for invoiceAddress in loop('invoice_address_identifiers', 'order_address', {id: order.INVOICE_ADDRESS}) %}
                {% if invoiceAddress.SIRET %}
                    <div>{{ 'Company registration number'|trans({}, 'pdf', document_locale) }} : {{ invoiceAddress.SIRET }}</div>
                {% endif %}
                {% if invoiceAddress.VAT_NUMBER %}
                    <div>{{ 'VAT number'|trans({}, 'pdf', document_locale) }} : {{ invoiceAddress.VAT_NUMBER }}</div>
                {% endif %}
            {% endfor %}
        </td>
    </tr>
</table>

{{ hook('invoice.after-addresses', {order: order_id}) }}

<table width="100%" cellspacing="0" cellpadding="0" style="padding-top: 5mm; padding-bottom: 8mm">
    <col style="width: 46%; padding: 1mm;" />
    <col style="width: 11%; padding: 1mm;" />
    <col style="width: 9%; padding: 1mm;" />
    <col style="width: 11%; padding: 1mm;" />
    <col style="width: 8%; padding: 1mm;" />
    <col style="width: 15%; padding: 1mm;" />

    <tr class="table-1">
        <td><h4>{{ 'Product'|trans({}, 'pdf', document_locale) }}</h4></td>
        <td><h4 class="align-center">{{ 'Unit. price'|trans({}, 'pdf', document_locale) }}</h4></td>
        <td><h4 class="align-center">{{ 'Tax'|trans({}, 'pdf', document_locale) }}</h4></td>
        <td><h4 class="align-center">{{ 'Unit taxed price'|trans({}, 'pdf', document_locale) }}</h4></td>
        <td><h4 class="align-center">{{ 'Quantity'|trans({}, 'pdf', document_locale) }}</h4></td>
        <td style="background:#f6993c"><h4 style="color:white;" class="align-center">{{ 'Total without tax'|trans({}, 'pdf', document_locale) }}</h4></td>
    </tr>
    {% for product in loop('order-products', 'order_product', {order: order.ID}) %}
        <tr class="table-2">
            <td>
                <p class="product-title">{{ product.TITLE }}</p>
                <p class="product-meta">{{ 'Ref'|trans({}, 'pdf', document_locale) }} {{ product.REF }}{% if product.PRODUCT_SALE_ELEMENTS_REF != product.REF %} / {{ product.PRODUCT_SALE_ELEMENTS_REF }}{% endif %}
                {%- for combination in loop('combinations', 'order_product_attribute_combination', {order_product: product.ID}) %} · {{ combination.ATTRIBUTE_TITLE }} : {{ combination.ATTRIBUTE_AVAILABILITY_TITLE }}{% endfor %}</p>

                {{ hook('invoice.product-list', {order_product: product.ID, order: order_id}) }}
            </td>
            <td><p class="align-right">{{ format_money(product.REAL_PRICE, currency) }}</p></td>
            <td><p class="align-right">{{ format_money(product.REAL_PRICE_TAX, currency) }}</p></td>
            <td><p class="align-right">{{ format_money(product.REAL_TAXED_PRICE, currency) }}</p></td>
            <td><p class="align-center">{{ product.QUANTITY }}</p></td>
            <td><p class="align-right">{{ format_money(product.REAL_TOTAL_PRICE, currency) }}</p></td>
        </tr>

        {{ hook('invoice.order-product', {order: order_id, order_product: product.ID}) }}
    {% endfor %}
</table>

{{ hook('invoice.after-products', {order: order_id}) }}

<table cellspacing="0" cellpadding="0" style="padding-top: 5mm; padding-bottom: 8mm">
    <col style="width: 60%; padding: 1mm;" />
    <col style="width: 40%; padding: 1mm;" />
    <tr>
        <td class="table-3-module">

            <h3>{{ 'Payment module'|trans({}, 'pdf', document_locale) }}</h3>
            <p>
                <span>{% for module in loop('payment-module', 'module', {id: order.PAYMENT_MODULE}) %}{{ module.TITLE }}{% endfor %}</span>
            </p>

            {{ hook('invoice.after-payment-module', {order: order_id, module_id: order.PAYMENT_MODULE}) }}

            <h3>{{ 'Delivery module'|trans({}, 'pdf', document_locale) }}</h3>
            <p>
                <span>{% for module in loop('delivery-module', 'module', {id: order.DELIVERY_MODULE}) %}{{ module.TITLE }}{% endfor %}</span>
            </p>

            {{ hook('invoice.after-delivery-module', {order: order_id, module_id: order.DELIVERY_MODULE}) }}

        </td>
        <td>
            <table class="table-3">
                <col style="width: 50%; padding: 0 1mm 1mm;">
                <col style="width: 50%; padding: 0 1mm 1mm;">

                {% set tva = 0.20 %}
                {% for invoiceAddress in loop('invoice_address', 'order_address', {id: order.INVOICE_ADDRESS}) %}
                    {% if invoiceAddress.COUNTRY == 20 and date(order.INVOICE_DATE) > date('2020-07-07') %}{% set tva = 0.21 %}{% endif %}
                {% endfor %}

                {% set untaxedCart = order.TOTAL_ITEMS_AMOUNT %}
                {% set untaxedPostage = order.POSTAGE_UNTAXED %}
                {% set postageTax = order.POSTAGE_TAX %}
                {% set untaxedTotalWithUntaxedPostage = order.TOTAL_ITEMS_AMOUNT + order.POSTAGE_UNTAXED %}

                {# Postage totals: without tax / tax rate / with tax #}
                <tr>
                    <td class="table-3-1"><p>{{ 'Total without tax'|trans({}, 'pdf', document_locale) }}</p></td>
                    <td class="table-3-1 align-right"><p>{{ format_money(untaxedCart, currency) }}</p></td>
                </tr>
                <tr>
                    <td class="table-3-1"><p>{{ 'Postage without tax'|trans({}, 'pdf', document_locale) }}</p></td>
                    <td class="table-3-1 align-right"><p>{{ format_money(untaxedPostage, currency) }}</p></td>
                </tr>
                <tr>
                    <td class="table-3-1"><p>{{ 'Tax rate'|trans({}, 'pdf', document_locale) }}</p></td>
                    <td class="table-3-1 align-right"><p>{{ tva * 100 }} %</p></td>
                </tr>
                <tr>
                    <td class="table-3-1"><p>{{ 'Postage tax amount'|trans({}, 'pdf', document_locale) }}</p></td>
                    <td class="table-3-1 align-right"><p>{{ format_money(postageTax, currency) }}</p></td>
                </tr>
                <tr>
                    <td class="table-3-1"><p>{{ 'Postage with tax'|trans({}, 'pdf', document_locale) }}</p></td>
                    <td class="table-3-1 align-right"><p>{{ format_money(untaxedPostage + postageTax, currency) }}</p></td>
                </tr>

                {# Customer discount rate, already included in the product prices above #}
                {% if order.CUSTOMER_DISCOUNT_RATE|default(0) > 0 %}
                <tr>
                    <td class="table-3-1"><p>{{ 'Customer discount rate'|trans({}, 'pdf', document_locale) }}</p></td>
                    <td class="table-3-1 align-right"><p>{{ order.CUSTOMER_DISCOUNT_RATE }} %</p></td>
                </tr>
                {% endif %}

                {# Cart + postage totals #}
                {% if hideTax|default(false) %}
                <tr>
                    <td class="table-3-1"><p>{{ 'Total'|trans({}, 'pdf', document_locale) }}</p></td>
                    <td class="table-3-1 align-right"><p>{{ format_money(order.TOTAL_TAXED_AMOUNT, currency) }}</p></td>
                </tr>
                {% else %}
                <tr>
                    <td class="table-3-1"><p>{{ 'Total without tax'|trans({}, 'pdf', document_locale) }}</p></td>
                    <td class="table-3-1 align-right"><p>{{ format_money(untaxedTotalWithUntaxedPostage, currency) }}</p></td>
                </tr>
                <tr>
                    <td class="table-3-1"><p>{{ 'Total tax amount'|trans({}, 'pdf', document_locale) }}</p></td>
                    <td class="table-3-1 align-right"><p>{{ format_money(order.TOTAL_ITEMS_TAX + postageTax, currency) }}</p></td>
                </tr>
                <tr>
                    <td class="table-3-1"><p>{{ 'Taxed total'|trans({}, 'pdf', document_locale) }}</p></td>
                    <td class="table-3-1 align-right"><p>{{ format_money(order.TOTAL_TAXED_AMOUNT + order.DISCOUNT, currency) }}</p></td>
                </tr>
                {% if order.DISCOUNT > 0 %}
                <tr>
                    <td class="table-3-1"><p>{{ 'Discount with tax'|trans({}, 'pdf', document_locale) }}</p></td>
                    <td class="table-3-1 align-right"><p>{{ format_money(order.DISCOUNT, currency) }}</p></td>
                </tr>
                {% endif %}
                <tr>
                    <td class="table-3-1" style="background:#f6993c;">
                        <h3 style="color:white;">{{ 'Total'|trans({}, 'pdf', document_locale) }}</h3>
                    </td>
                    <td class="table-3-1 align-right" style="background:#f6993c;">
                        <h3 style="color:white;">{{ format_money(order.TOTAL_TAXED_AMOUNT, currency) }}</h3>
                    </td>
                </tr>
                {% endif %}
            </table>
        </td>
    </tr>
</table>

{{ hook('invoice.after-summary', {order: order_id}) }}

{% endfor %}
